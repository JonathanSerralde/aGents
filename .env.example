# Copia este archivo a .env y completa solo lo que uses.
# .env se queda en tu equipo y está ignorado por git.

# Puerto local (la app solo escucha en 127.0.0.1)
PORT=4791

# Proveedor de IA: anthropic | openai | ninguno
# Con "ninguno" el diagnóstico usa solo reglas, sin enviar nada a terceros.
PROVEEDOR_IA=ninguno

# Claves propias de la API (no uses tu suscripción de Claude ni de ChatGPT)
ANTHROPIC_API_KEY=
MODELO_ANTHROPIC=claude-haiku-5-5

OPENAI_API_KEY=
MODELO_OPENAI=
